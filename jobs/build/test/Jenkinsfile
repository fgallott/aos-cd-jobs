#!/usr/bin/env groovy

node {
    timestamps {
        properties([
            parameters([
                choice(
                    name: "SIGNING_ENV",
                    choices: ["stage", "prod"],
                    description: "Signing environment to validate"
                )
            ])
        ])

        def signingEnv = params.SIGNING_ENV ?: "stage"

        if (signingEnv == "stage") {
            stage("Validate stage signing credentials") {
                withCredentials([
                    file(
                        credentialsId: "ocp-art-signing-stage.keytab",
                        variable: "DIRECT_SIGNING_STAGE_KEYTAB"
                    ),
                    string(
                        credentialsId: "ocp-art-signing-stage.user",
                        variable: "DIRECT_SIGNING_STAGE_PRINCIPAL"
                    )
              ]) {
                  sh(
                      label: "Sign with beta2",
                      script: '''
                          set -eu
                          umask 077

                          test -s "$DIRECT_SIGNING_STAGE_KEYTAB"
                          test "$DIRECT_SIGNING_STAGE_PRINCIPAL" = \
                              "ocp-art-signing-stage@IPA.REDHAT.COM"

                          command -v kinit
                          command -v klist
                          command -v kdestroy
                          command -v rh-signing-client

                          work_dir="$(mktemp -d /tmp/art-beta2-sign-test.XXXXXX)"
                          payload="$work_dir/payload.txt"
                          gpg_signature="$work_dir/payload.gpg"

                          export KRB5CCNAME="FILE:$work_dir/ccache"

                          cleanup() {
                              kdestroy -c "$KRB5CCNAME" >/dev/null 2>&1 || true
                              rm -rf -- "$work_dir"
                          }

                          trap cleanup EXIT

                          kinit \
                              -k \
                              -t "$DIRECT_SIGNING_STAGE_KEYTAB" \
                              -c "$KRB5CCNAME" \
                              "$DIRECT_SIGNING_STAGE_PRINCIPAL"

                          klist -s -c "$KRB5CCNAME"

                          printf '%s\\n' "ART beta2 signing smoke test" > "$payload"

                          rh-signing-client \
                              --key beta2 \
                              "$payload" \
                              --gpgsign \
                              --output "$gpg_signature" \
                              --onbehalfof "jupierce@redhat.com"

                          test -s "$gpg_signature"
                          echo "beta2 --gpgsign succeeded"
                      '''
                  )
              }
            }
        } else {
            stage("Validate prod signing credentials") {
                withCredentials([
                    file(
                        credentialsId: "ocp-art-signing-prod.keytab",
                        variable: "DIRECT_SIGNING_PROD_KEYTAB"
                    ),
                    string(
                        credentialsId: "ocp-art-signing-prod.user",
                        variable: "DIRECT_SIGNING_PROD_PRINCIPAL"
                    )
              ]) {
                  sh(
                      label: "Sign with beta2",
                      script: '''
                          set -eu
                          umask 077

                          test -s "$DIRECT_SIGNING_PROD_KEYTAB"
                          test "$DIRECT_SIGNING_PROD_PRINCIPAL" = \
                              "ocp-art-signing-prod@IPA.REDHAT.COM"

                          command -v kinit
                          command -v klist
                          command -v kdestroy
                          command -v rh-signing-client

                          work_dir="$(mktemp -d /tmp/art-beta2-sign-test.XXXXXX)"
                          payload="$work_dir/payload.txt"
                          gpg_signature="$work_dir/payload.gpg"

                          export KRB5CCNAME="FILE:$work_dir/ccache"

                          cleanup() {
                              kdestroy -c "$KRB5CCNAME" >/dev/null 2>&1 || true
                              rm -rf -- "$work_dir"
                          }

                          trap cleanup EXIT

                          kinit \
                              -k \
                              -t "$DIRECT_SIGNING_PROD_KEYTAB" \
                              -c "$KRB5CCNAME" \
                              "$DIRECT_SIGNING_PROD_PRINCIPAL"

                          klist -s -c "$KRB5CCNAME"

                          printf '%s\\n' "ART beta2 signing smoke test" > "$payload"

                          rh-signing-client \
                              --key beta2 \
                              "$payload" \
                              --gpgsign \
                              --output "$gpg_signature" \
                              --onbehalfof "jupierce@redhat.com"

                          test -s "$gpg_signature"
                          echo "beta2 --gpgsign succeeded"
                      '''
                  )
              }
            }
        }
    }
}
